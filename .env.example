# ---------------------------------------------------------------
# Per-project config — the only values you need to change when
# lifting this emulator setup into a different Firebase project.
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# Firebase / GCP project ID (passed to `firebase emulators:start --project`)
PROJECT_ID=your-project-id

# Used by Firebase Admin SDK (staging / production)
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=(default)

# Emulator host — set automatically by seed scripts for NODE_ENV=development
# FIRESTORE_EMULATOR_HOST=localhost:8083
